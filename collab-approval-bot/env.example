# 复制到 ~/.config/collab/feishu.env 并 chmod 600
# 程序启动时自动读取；已存在的环境变量优先。
COLLAB_REPO=/Users/juexing/.collab-bridge/repos/collab-mvp-demo
COLLAB_BOT_MEMBER=human

# 可选：镜像仓根目录（COLLAB_REPO 未显式设置时，默认取 $COLLAB_BRIDGE_MIRROR_ROOT/collab-mvp-demo）
# COLLAB_BRIDGE_MIRROR_ROOT=/Users/juexing/.collab-bridge/repos

# 可选：预置主人 open_id（逗号分隔）。留空则首次启动用 BIND_CODE 绑定。
# COLLAB_BOT_OWNER_IDS=ou_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

COLLAB_BOT_CMD_TIMEOUT=120
COLLAB_BOT_POLL_SECONDS=120

# 必须与创建应用时使用的目录一致
LARKSUITE_CLI_CONFIG_DIR=/Users/juexing/.lark-cli-collab

# lark-cli 默认路径；一般不用改
# COLLAB_BOT_LARK_CLI=/Users/juexing/.local/bin/lark-cli

# 可选：官方 SDK（lark-oapi）长连接模式，二者同时配置即启用（否则走 lark-cli）。
# 启用后可同步返回飞书原生 Toast、支持卡片 JSON 2.0；需 `pip install lark-oapi`。
# FEISHU_APP_ID=cli_xxxxxxxxxxxxxxxx
# FEISHU_APP_SECRET=xxxxxxxxxxxxxxxx
